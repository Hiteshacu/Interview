<Window x:Class="InterviewAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Interview Assistant - Settings"
        Width="760"
        Height="780"
        MinWidth="680"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="AI Interview Assistant" FontSize="26" FontWeight="SemiBold" Foreground="#13233F"/>
                <TextBlock Text="A visible, user-controlled assistant for interviews where AI assistance is permitted."
                           Margin="0,5,0,0" Foreground="#53647D" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- LLM Connection -->
            <Border Grid.Row="1" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LLM connection" FontSize="16" FontWeight="SemiBold" Foreground="#13233F"/>
                    <Grid Grid.Row="1" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Active LLM Provider" Foreground="#53647D"/>
                            <ComboBox x:Name="ProviderComboBox" Margin="0,5,0,0" Padding="8">
                                <ComboBoxItem Content="Groq"/>
                                <ComboBoxItem Content="Gemini"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Groq Text Model" Foreground="#53647D"/>
                            <TextBox x:Name="ModelBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Groq Vision Model" Foreground="#53647D"/>
                            <TextBox x:Name="GroqVisionModelBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gemini Vision Model" Foreground="#53647D"/>
                            <TextBox x:Name="GeminiVisionModelBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Groq API Key" Foreground="#53647D"/>
                            <PasswordBox x:Name="GroqKeyBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gemini API Key" Foreground="#53647D"/>
                            <PasswordBox x:Name="GeminiKeyBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,13,0,0">
                        <StackPanel>
                            <TextBlock Text="Groq OpenAI-compatible endpoint" Foreground="#53647D"/>
                            <TextBox x:Name="ApiEndpointBox" Margin="0,5,0,0" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Protection & Intelligence Features -->
            <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Protection &amp; Context Options" FontSize="16" FontWeight="SemiBold" Foreground="#13233F"/>
                    <TextBlock Text="Control overlay visibility during screen capture and automated UI text extraction." Margin="0,4,0,12" Foreground="#53647D" TextWrapping="Wrap"/>
                    <CheckBox x:Name="EnableProtectionBox" Content="Exclude overlay from screen capture &amp; recording (WDA protection)" Margin="0,0,0,8" IsChecked="True" Foreground="#13233F" FontWeight="Medium"/>
                    <CheckBox x:Name="AutoUiaBox" Content="Enable Windows UI Automation context reader (Read Window)" IsChecked="True" Foreground="#13233F"/>
                </StackPanel>
            </Border>

            <!-- Hotkey -->
            <Border Grid.Row="3" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Shortcut" FontSize="16" FontWeight="SemiBold" Foreground="#13233F"/>
                    <TextBlock Text="Uses Windows registered hotkeys. The assistant opens as a normal visible window." Margin="0,4,0,12" Foreground="#53647D" TextWrapping="Wrap"/>
                    <WrapPanel VerticalAlignment="Center">
                        <CheckBox x:Name="ControlBox" Content="Ctrl" Margin="0,0,14,0"/>
                        <CheckBox x:Name="AltBox" Content="Alt" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ShiftBox" Content="Shift" Margin="0,0,14,0"/>
                        <CheckBox x:Name="WindowsBox" Content="Win" Margin="0,0,14,0"/>
                        <ComboBox x:Name="HotkeyBox" Width="110"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Overlay Appearance -->
            <Border Grid.Row="4" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Overlay appearance" FontSize="16" FontWeight="SemiBold" Foreground="#13233F"/>
                    <Grid Grid.Row="1" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Opacity" Foreground="#53647D"/><Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" SmallChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Width" Foreground="#53647D"/><TextBox x:Name="WidthBox" Margin="0,5,0,0" Padding="8"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Height" Foreground="#53647D"/><TextBox x:Name="HeightBox" Margin="0,5,0,0" Padding="8"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Left position" Foreground="#53647D"/><TextBox x:Name="LeftBox" Margin="0,5,0,0" Padding="8"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Top position" Foreground="#53647D"/><TextBox x:Name="TopBox" Margin="0,5,0,0" Padding="8"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <DockPanel Grid.Row="5">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#385982" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save settings" Click="SaveSettings_Click" Padding="15,8" Margin="0,0,8,0"/>
                    <Button Content="Open assistant" Click="OpenAssistant_Click" Padding="15,8" Margin="0,0,8,0" Background="#2767C8" Foreground="White" BorderBrush="#2767C8"/>
                    <Button Content="Exit" Click="Exit_Click" Padding="15,8"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
