<Window x:Class="OverlayAlert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Overlay System"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" x:Name="StatusBorder" Background="#2288CC44" Padding="10">
            <TextBlock x:Name="StatusText"
                       Text="Initializing..."
                       Foreground="#88CC44"
                       FontWeight="Bold"/>
        </Border>

        <!-- Config Section -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Alert Configuration"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Alert Title:" Margin="0,0,0,5"/>
            <TextBox x:Name="AlertTextBox"
                     Text="SECURITY ALERT"
                     Margin="0,0,0,15"
                     Padding="8"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20">
            <Button Content="Test Overlay"
                    Click="TestOverlay_Click"
                    Padding="15,8"
                    Margin="0,0,10,0"/>
            <Button Content="Minimize to Tray"
                    Click="MinimizeToTray_Click"
                    Padding="15,8"
                    Margin="0,0,10,0"/>
            <Button Content="Exit"
                    Click="Exit_Click"
                    Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
