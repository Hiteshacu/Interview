<Window x:Class="InterviewAssistant.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Interview Assistant"
        Width="540"
        Height="660"
        MinWidth="360"
        MinHeight="420"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F5F7FB"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#EAF2FF" BorderBrush="#B7D0F5" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
            <DockPanel>
                <Border x:Name="ProtectionBadgeBorder" DockPanel.Dock="Right" VerticalAlignment="Center" Background="#DFF6DD" BorderBrush="#107C41" BorderThickness="1" CornerRadius="4" Padding="6,2">
                    <TextBlock x:Name="ProtectionBadge" Text="Protected" FontSize="11" FontWeight="Bold" Foreground="#107C41"/>
                </Border>
                <ComboBox x:Name="ProviderToggleCombo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="ProviderToggleCombo_SelectionChanged" MinWidth="75">
                    <ComboBoxItem Content="Groq"/>
                    <ComboBoxItem Content="Gemini"/>
                </ComboBox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI Interview Assistant" FontSize="16" FontWeight="SemiBold" Foreground="#173B70"/>
                    <TextBlock Text="Visible assistance for permitted interviews. Verify all answers." Margin="0,2,0,0" FontSize="11" Foreground="#48678E" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Message History -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E2EF" BorderThickness="1" Padding="10">
            <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Attachment Chip Bar -->
        <Border x:Name="AttachmentPanel" Grid.Row="2" Visibility="Collapsed" Background="#F0F4F8" BorderBrush="#D9E2EF" BorderThickness="1" Padding="8,5" Margin="0,8,0,0" CornerRadius="4">
            <DockPanel>
                <Button Content="✕" Click="ClearAttachment_Click" DockPanel.Dock="Right" Padding="6,1" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#A80000" FontWeight="Bold" Cursor="Hand"/>
                <TextBlock x:Name="AttachmentText" Text="📎 Screenshot attached" VerticalAlignment="Center" Foreground="#1F5393" FontWeight="SemiBold" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Action Toolbar & Input -->
        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Quick Actions Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="⚡ Read Window (UIA)" Click="UiaRead_Click" Padding="8,4" Margin="0,0,6,0" Background="#E1DFDD" BorderBrush="#C8C6C4" FontSize="11" FontWeight="Medium" ToolTip="Extract text directly from active window controls (no screenshot)"/>
                <Button Content="👁 Watch Screen" Click="WatchScreen_Click" Padding="8,4" Margin="0,0,6,0" Background="#E1DFDD" BorderBrush="#C8C6C4" FontSize="11" FontWeight="Medium" ToolTip="Capture full screen and send to vision AI model"/>
                <Button Content="📎 Attach Image" Click="AttachImage_Click" Padding="8,4" Background="#E1DFDD" BorderBrush="#C8C6C4" FontSize="11" FontWeight="Medium" ToolTip="Attach screenshot from clipboard or file"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Padding="8" KeyDown="QuestionBox_KeyDown" PreviewKeyDown="QuestionBox_PreviewKeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Ask" Margin="8,0,0,0" Click="SendButton_Click" Background="#2767C8" Foreground="White" BorderBrush="#2767C8" FontWeight="SemiBold"/>
            </Grid>
        </Grid>

        <!-- Footer / Status Bar -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#53647D" TextWrapping="Wrap" MaxWidth="280"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy last" Click="CopyLast_Click" Padding="8,5" Margin="0,0,5,0"/>
                <Button Content="Clear" Click="Clear_Click" Padding="8,5" Margin="0,0,5,0"/>
                <Button Content="Hide" Click="Hide_Click" Padding="8,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
